---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = test;
    fields := struct {
        enum : i8 {
            A = -3 ... -1,
            B = 0 ... 2,
            C = -128 ... -100,
        } tag;
        variant <tag> {
            string A;
            u16 B;
            u8 C[2];
        } v;
    };
};
