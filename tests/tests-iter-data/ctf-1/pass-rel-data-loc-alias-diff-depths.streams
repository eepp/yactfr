---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = test;
    fields := struct {
        u8 len;

        typealias struct {
            u8 seq[len];
        } := s;

        s a;

        struct {
            u8 len;

            struct {
                s c;
            } b;
        } d;
    };
};
---
# event record
