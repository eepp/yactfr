---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = test;
    fields := struct {
        u8 len;

        struct s {
            u8 seq[len];
        } x;

        struct {
            u8 len;
            struct s y;
        } z;
    };
};
---
# event record
