---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = test;
    fields := struct {
        u8 length_field;
        typedef u8 typename[length_field];
        typename seq_field_name;
    };
};
---
# event record
03          # `length_field`
aa bb cc    # `seq_field_name` (length: `length_field`)
---
     0 P {
     0   PC {
     0     DSI:T0
     0     PI
     0     ER {
     0       ERI:T0:#test
     0       SC:5 {
     0         ST {
     0           FLUI:length_field:3
     8           DLA:seq_field_name {
     8             FLUI:170
    16             FLUI:187
    24             FLUI:204
    32           }
    32         }
    32       }
    32     }
    32   }
    32 }
