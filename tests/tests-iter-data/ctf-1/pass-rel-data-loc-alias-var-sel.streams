---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = test;
    fields := struct {
        enum : u8 {
            A, B,
        } tag;

        typealias variant <tag> {
            string A;
            u32 B;
        } := v;

        struct {
            enum : u8 {
                B, A,
            } tag;

            v var;
        } s;
    };
};
---
# event record
01              # `tag` (`B`)
01              # `s.tag` (`A`)
[0x12345678 : 32be] # `s.var` (selector: `tag`)
---
     0 P {
     0   PC {
     0     DSI:T0
     0     PI
     0     ER {
     0       ERI:T0:#test
     0       SC:5 {
     0         ST {
     0           FLUI:tag:1
     8           ST:s {
     8             FLUI:tag:1
    16             VU:var:1 {
    16               FLUI:305419896
    48             }
    48           }
    48         }
    48       }
    48     }
    48   }
    48 }
