---
trace {
    major = 1;
    minor = 8;
    byte_order = be;
};

event {
    name = ev;
    fields := struct {
        /*
         * The text of each `integer` block below is longer than
         * 256 characters, the maximum size of a fast fixed-length
         * integer type entry of the TSDL parser.
         */
        integer {
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            size = 16;
            signed = true;
            byte_order = le;
        } a;
        integer {
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            size = 16;
            signed = true;
            byte_order = le;
        } b;
        integer {
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            /* This comment makes the block longer than 256 chars. */
            size = 16;
            byte_order = be;
        } c;
    };
};
---
!be

[-2 : 16le]     # `a`
[1234 : 16le]   # `b`
[4660 : 16]     # `c`
---
     0 P {
     0   PC {
     0     DSI:T0
     0     PI
     0     ER {
     0       ERI:T0:#ev
     0       SC:5 {
     0         ST {
     0           FLSI:a:-2
    16           FLSI:b:1234
    32           FLUI:c:4660
    48         }
    48       }
    48     }
    48   }
    48 }
