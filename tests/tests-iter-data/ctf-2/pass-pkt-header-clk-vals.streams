---
[
  {
    "type": "preamble",
    "version": 2,
    "uuid": [100, 23, 75, 150, 74, 129, 77, 189, 141, 226, 104, 26, 41, 230, 62, 11]
  },
  {
    "type": "trace-class",
    "packet-header-field-class": {
      "type": "structure",
      "member-classes": [
        {
          "name": "magic",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 32,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["packet-magic-number"]
          }
        },
        {
          "name": "uuid",
          "field-class": {
            "type": "static-length-blob",
            "length": 16,
            "roles": ["metadata-stream-uuid"]
          }
        },
        {
          "name": "dsc_id",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 8,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["data-stream-class-id"]
          }
        }
      ]
    }
  },
  {
    "type": "clock-class",
    "id": "clk",
    "frequency": 1000000000
  },
  {
    "type": "data-stream-class",
    "id": 3,
    "default-clock-class-id": "clk",
    "packet-context-field-class": {
      "type": "structure",
      "member-classes": [
        {
          "name": "total_len",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 16,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["packet-total-length"]
          }
        },
        {
          "name": "content_len",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 16,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["packet-content-length"]
          }
        },
        {
          "name": "begin_ts",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 64,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["default-clock-timestamp"]
          }
        },
        {
          "name": "end_ts",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 64,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["packet-end-default-clock-timestamp"]
          }
        }
      ]
    },
    "event-record-header-field-class": {
      "type": "structure",
      "member-classes": [
        {
          "name": "id",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 8,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["event-record-class-id"]
          }
        },
        {
          "name": "ts",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 16,
            "byte-order": "big-endian",
            "alignment": 8,
            "roles": ["default-clock-timestamp"]
          }
        }
      ]
    }
  },
  {
    "type": "event-record-class",
    "data-stream-class-id": 3,
    "id": 7,
    "name": "ev",
    "payload-field-class": {
      "type": "structure",
      "member-classes": [
        {
          "name": "x",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 8,
            "byte-order": "big-endian",
            "alignment": 8
          }
        }
      ]
    }
  }
]
---
!macro pkt_header()
  c1fc1fc1                                         # `magic`
  64 17 4b 96 4a 81 4d bd 8d e2 68 1a 29 e6 3e 0b  # `uuid`
  03                                               # `dsc_id`
!end

!macro er(ts, x)
  07           # `id`
  [ts : 16]    # `ts`
  [x : 8]      # `x`
!end

!be

# first packet
m:pkt_header()
[448 : 16]                 # `total_len`
[424 : 16]                 # `content_len`
[0x1_0000_fff0 : 64]       # `begin_ts`
[0x1_0002_0005 : 64]       # `end_ts`
m:er(0xfff8, 1)
m:er(0x0003, 2)            # wraps
m:er(0x0003, 3)
00 00 00                   # padding

# second packet
m:pkt_header()
[360 : 16]                 # `total_len`
[360 : 16]                 # `content_len`
[5 : 64]                   # `begin_ts`
[16 : 64]                  # `end_ts`
m:er(0x0007, 4)
