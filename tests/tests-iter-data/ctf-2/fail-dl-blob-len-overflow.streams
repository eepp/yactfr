---
[
  {
    "type": "preamble",
    "version": 2
  },
  {
    "type": "trace-class"
  },
  {
    "packet-context-field-class": {
      "member-classes": [
        {
          "field-class": {
            "byte-order": "big-endian",
            "length": 16,
            "roles": [
              "packet-total-length"
            ],
            "type": "fixed-length-unsigned-integer"
          },
          "name": "packet_size"
        },
        {
          "field-class": {
            "byte-order": "big-endian",
            "length": 16,
            "roles": [
              "packet-content-length"
            ],
            "type": "fixed-length-unsigned-integer"
          },
          "name": "content_size"
        }
      ],
      "type": "structure"
    },
    "type": "data-stream-class"
  },
  {
    "name": "test",
    "payload-field-class": {
      "member-classes": [
        {
          "field-class": {
            "byte-order": "big-endian",
            "length": 64,
            "type": "fixed-length-unsigned-integer"
          },
          "name": "len"
        },
        {
          "field-class": {
            "type": "dynamic-length-blob",
            "length-field-location": {
              "origin": "event-record-payload",
              "path": ["len"]
            }
          },
          "name": "blob"
        }
      ],
      "type": "structure"
    },
    "type": "event-record-class"
  }
]
---
!be

[256 : 16]                  # packet total size
[128 : 16]                  # packet content size
20 00 00 00 00 00 00 01     # `len` (2^61 + 1)
11 22 33 44                 # `blob`
55 66 77 88 99 aa bb cc     # padding
dd ee ff 00 11 22 33 44
55 66 77 88 99 aa bb cc
dd ee ff 00 11 22 33 44
---
     0 P {
     0   PC {
     0     DSI:T0
     0     SC:1 {
     0       ST {
     0         FLUI:packet_size:256
    16         FLUI:content_size:128
    32       }
    32     }
    32     PI:T256:C128
    32     ER {
    32       ERI:T0:#test
    32       SC:5 {
    32         ST {
    32           FLUI:len:2305843009213693953
    96           DLB:blob:application/octet-stream {
    96 Cannot read 18446744073709551615 bits at this point: would move beyond the content of the current packet (32 bits remaining).
