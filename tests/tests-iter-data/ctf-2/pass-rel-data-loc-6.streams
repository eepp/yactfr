---
[
  {
    "type": "preamble",
    "version": 2
  },
  {
    "type": "trace-class"
  },
  {
    "type": "data-stream-class"
  },
  {
    "type": "event-record-class",
    "name": "test",
    "payload-field-class": {
      "type": "structure",
      "member-classes": [
        {
          "name": "len",
          "field-class": {
            "type": "fixed-length-unsigned-integer",
            "length": 8,
            "byte-order": "big-endian"
          }
        },
        {
          "name": "outer",
          "field-class": {
            "type": "structure",
            "member-classes": [
              {
                "name": "len",
                "field-class": {
                  "type": "fixed-length-unsigned-integer",
                  "length": 8,
                  "byte-order": "big-endian"
                }
              },
              {
                "name": "inner",
                "field-class": {
                  "type": "structure",
                  "member-classes": [
                    {
                      "name": "str",
                      "field-class": {
                        "type": "dynamic-length-string",
                        "length-field-location": {
                          "path": [
                            null,
                            null,
                            "len"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
]
---
[end - beg : 8]   # `len`
03                # `outer.len`

<beg>
  "meow mix"      # `outer.inner.str`
<end>
---
     0 P {
     0   PC {
     0     DSI:T0
     0     PI
     0     ER {
     0       ERI:T0:#test
     0       SC:5 {
     0         ST {
     0           FLUI:len:8
     8           ST:outer {
     8             FLUI:len:3
    16             ST:inner {
    16               DLS:str {
    16                 RD:8:meow mix
    80               }
    80             }
    80           }
    80         }
    80       }
    80     }
    80   }
    80 }
